{
  "name": "blackborne",
  "version": "0.2.0",
  "description": "A UI component library for React, built for management applications.",
  "author": "Carlos Junior Ramos Vásquez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juniorencode/blackborne.git",
    "directory": "packages/blackborne"
  },
  "homepage": "https://github.com/juniorencode/blackborne",
  "bugs": "https://github.com/juniorencode/blackborne/issues",
  "keywords": [
    "react",
    "react-components",
    "component-library",
    "design-system",
    "accessibility",
    "react-aria",
    "rtl",
    "blackborne"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "tokens": "node scripts/generate-primitives.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "build:js": "vite build",
    "build:css": "tailwindcss -i src/styles/index.css -o dist/styles.css",
    "build": "pnpm build:types && pnpm build:js && pnpm build:css",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json"
  },
  "devDependencies": {
    "@radix-ui/colors": "3.0.0",
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "react-aria-components": "1.21.0"
  }
}
