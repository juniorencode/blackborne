node_modules/
dist/
coverage/
storybook-static/
*.tsbuildinfo
.DS_Store
.env
.env.*
!.env.example
*.log
.turbo/
test-results/
playwright-report/

# Personal overrides, never committed
.claude/settings.local.json

# Storybook build output and Playwright artefacts
apps/catalog/storybook-static/
apps/catalog/playwright-report/
apps/catalog/test-results/

# The Docker container writes its dependency store here when it installs.
# It is a cache, not source, and must never be committed or linted.
.pnpm-store/

# Baselines are generated in the Docker container, so only -linux ones are
# real. A -win32 file is one somebody took locally by mistake; the platform
# suffix exists to make that visible in review rather than mysterious in CI.
apps/catalog/e2e/__screenshots__/*-win32.png
apps/catalog/e2e/__screenshots__/*-darwin.png
