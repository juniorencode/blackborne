{
  "name": "catalog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The visual catalog. Several rules in the foundations can only be checked here.",
  "scripts": {
    "dev": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build": "storybook build -o storybook-static",
    "preview": "vite preview --outDir storybook-static --host 127.0.0.1 --port 6007 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "playwright test --project=checks --project=narrow",
    "test:a11y": "playwright test --project=a11y",
    "test:visual": "playwright test --project=visual --workers=1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.6.0",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "dependencies": {
    "blackborne": "workspace:*"
  }
}
